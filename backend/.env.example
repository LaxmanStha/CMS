# Backend configuration (documentation only — the C++ server reads college.db from its working directory)
# SQLite database file (relative to the server's working directory, i.e. backend/build/bin)
DB_FILE=college.db
# HTTP port the C++ REST API listens on
PORT=8080
# CORS: origins allowed to call the API (the dev server runs on 5173)
CORS_ORIGIN=http://localhost:5173
